#version 460
#extension GL_EXT_control_flow_attributes : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_KHR_shader_subgroup_vote : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_buffer_reference : require
#extension GL_KHR_memory_scope_semantics : require
#pragma use_vulkan_memory_model


layout(constant_id = 0) const uint GROUP = 32;
layout(constant_id = 1) const uint EXPERIMENT = 0;
layout(constant_id = 2) const uint RING = 512;
layout(constant_id = 3) const uint PAD = 0;
layout(constant_id = 4) const uint LIT_ROOT = 9;
layout(constant_id = 5) const uint DIST_ROOT = 7;
layout(local_size_x_id = 0) in;

struct tile_t {
    uint src;
    uint words;
    uint dst;
    uint size;
};

struct region_t {
    uint64_t src;
    uint64_t dst;
    uint64_t csize;
    uint64_t size;
};

layout(buffer_reference, std430, buffer_reference_align = 4) restrict readonly buffer src_ref { uint words[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) restrict readonly buffer tiles_ref { tile_t tiles[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) subgroupcoherent buffer dst_ref { uint8_t bytes[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) subgroupcoherent buffer dst32_ref { uint words[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) restrict writeonly buffer status_ref { uint words[]; };
layout(buffer_reference, std430, buffer_reference_align = 8) restrict readonly buffer region_ref { region_t region; };
layout(buffer_reference, std430, buffer_reference_align = 4) restrict readonly buffer count_ref { uint n; };

layout(push_constant) uniform pc_t {
    src_ref src;
    tiles_ref tiles;
    dst_ref dst;
    status_ref status;
    count_ref count;
    uint stride;
} pc;

const uint LANES = 32;
const uint PRE_ROOT = 7;
const uint TAB_LIT = 0;
const uint TAB_DIST = 1u << LIT_ROOT;
const uint TAB_PRE = TAB_DIST;
const uint TAB_HALVES = (1u << LIT_ROOT) + (1u << DIST_ROOT);
const uint SORTED_LIT = 0;
const uint SORTED_DIST = 288;
const uint LENS_PRE = 320;
const uint NONE = 0xffffffffu;
const uint QW = 128;

const uint ERR_INPUT = 1;
const uint ERR_BLOCK_TYPE = 2;
const uint ERR_PRECODE = 3;
const uint ERR_CODE_LENGTHS = 4;
const uint ERR_LITLEN_CODE = 5;
const uint ERR_DIST_CODE = 6;
const uint ERR_SYMBOL = 7;
const uint ERR_OUTPUT = 8;
const uint ERR_DISTANCE = 9;
const uint ERR_SIZE = 10;

shared uint lds_tab[TAB_HALVES / 2];
shared uint lds_sorted[107];
shared uint lds_lens[43];
shared uint lds_run[15];
shared uint lds_in[QW];
shared uint8_t lds_ring[RING + PAD + 4u];

struct reader_t {
    uint src;
    uint words;
    uint next;
    uint wbase;
    uint err;
};

struct lane_t {
    uint64_t buf;
    uint cnt;
};

uint lane;
uint lt_mask;
src_ref g_src;
dst_ref g_dst;
uint g_win;
bool g_mirror;
bool g_cache;
bool g_lits;

uint half_get(uint i) {
    return (lds_tab[i >> 1] >> ((i & 1u) << 4)) & 0xffffu;
}

void half_or(uint i, uint v) {
    atomicOr(lds_tab[i >> 1], v << ((i & 1u) << 4));
}

uint sorted_get(uint i) {
    uint d = i / 3u;
    return (lds_sorted[d] >> ((i - d * 3u) * 9u)) & 511u;
}

void sorted_or(uint i, uint v) {
    uint d = i / 3u;
    atomicOr(lds_sorted[d], v << ((i - d * 3u) * 9u));
}

uint len_get(uint s) {
    return (lds_lens[s >> 3] >> ((s & 7u) << 2)) & 15u;
}

void len_or(uint s, uint v) {
    atomicOr(lds_lens[s >> 3], v << ((s & 7u) << 2));
}

uint in_word(uint i) {
    return g_src.words[i];
}

uint out_get(uint i) {
    return uint(g_dst.bytes[i]);
}

void out_set(uint i, uint v) {
    g_dst.bytes[i] = uint8_t(v);
}

void out_set32(uint i, uint v) {
    dst32_ref(uint64_t(g_dst)).words[i >> 2] = v;
}

uint out_word(uint w) {
    return dst32_ref(uint64_t(g_dst)).words[w];
}

uint ring_get(uint x) {
    return uint(lds_ring[x & (RING - 1u)]);
}

void ring_set(uint x, uint v) {
    if (x >= g_win && g_mirror && RING != 0u && EXPERIMENT != 22)
        lds_ring[x & (RING - 1u)] = uint8_t(v);
}

uint load_packet(reader_t r, uint idx) {
    return in_word(r.src + min(idx, r.words - 1u));
}

void shared_fence() {
    controlBarrier(gl_ScopeSubgroup, gl_ScopeSubgroup, gl_StorageSemanticsShared, gl_SemanticsAcquireRelease);
}

void stage_sync(inout reader_t r) {
    while (r.wbase - r.next < 64u) {
        lds_in[(r.wbase + lane) & (QW - 1u)] = load_packet(r, r.wbase + lane);
        r.wbase += LANES;
        shared_fence();
    }
}

void refill_staged(inout reader_t r, inout lane_t l, bool need) {
    need = need && l.cnt < 32u;
    uint b = subgroupBallot(need).x;
    uint w = lds_in[(r.next + bitCount(b & lt_mask)) & (QW - 1u)];
    if (need) {
        l.buf |= uint64_t(w) << l.cnt;
        l.cnt += 32u;
    }
    r.next += bitCount(b);
    if (r.next > r.words)
        r.err = ERR_INPUT;
}

void refill(inout reader_t r, inout lane_t l, bool need) {
    refill_staged(r, l, need);
    stage_sync(r);
}

void eat(inout lane_t l, uint n) {
    l.buf >>= n;
    l.cnt -= n;
}

uint build(uint nsym, uint lens_at, uint tab, uint sbase, uint root, out uint p[8]) {
    uint entries = 1u << root;
    for (uint i = lane; i < entries / 2; i += LANES)
        lds_tab[(tab >> 1) + i] = 0u;
    if (sbase != NONE)
        for (uint i = lane; i < (nsym + 2u) / 3u; i += LANES)
            lds_sorted[sbase / 3u + i] = 0u;
    if (lane < 15)
        lds_run[lane] = 0u;
    subgroupBarrier();
    for (uint s = lane; s < nsym; s += LANES) {
        uint l = len_get(lens_at + s);
        if (l != 0u)
            atomicAdd(lds_run[l - 1u], 1u);
    }
    subgroupBarrier();
    bool mine = lane >= 1u && lane <= 15u;
    uint cnt = mine ? lds_run[clamp(lane, 1u, 15u) - 1u] : 0u;
    uint first = 0, offs = 0;
    uint lim = mine ? lane : 0u;
    for (uint j = 1; j < lim; j++) {
        uint c = lds_run[j - 1u];
        first = (first + c) << 1;
        offs += c;
    }
    uint kraft = subgroupAdd(mine ? cnt << (15u - lane) : 0u);
    uint single = subgroupShuffle(cnt, 1);
    uint pk = ((mine ? (first + cnt) << (15u - lane) : 0u) << 16) | ((sbase + offs - first) & 0xffffu);
    p[0] = subgroupBroadcast(pk, root + 1u);
    p[1] = subgroupBroadcast(pk, root + 2u);
    p[2] = subgroupBroadcast(pk, root + 3u);
    p[3] = subgroupBroadcast(pk, root + 4u);
    p[4] = subgroupBroadcast(pk, root + 5u);
    p[5] = subgroupBroadcast(pk, root + 6u);
    p[6] = subgroupBroadcast(pk, root + 7u);
    p[7] = subgroupBroadcast(pk, root + 8u);
    subgroupBarrier();
    if (lane < 15)
        lds_run[lane] = 0u;
    subgroupBarrier();
    uint mode = 0;
    if (kraft == 0u)
        mode = 1;
    else if (kraft == 16384u && single == 1u)
        mode = 2;
    else if (kraft != 32768u)
        mode = 3;
    if (mode == 1 || mode == 3)
        return mode;
    for (uint chunk = 0; chunk < nsym; chunk += LANES) {
        uint s = chunk + lane;
        uint l = s < nsym ? len_get(lens_at + s) : 0u;
        uint b0 = subgroupBallot((l & 1u) != 0u).x;
        uint b1 = subgroupBallot((l & 2u) != 0u).x;
        uint b2 = subgroupBallot((l & 4u) != 0u).x;
        uint b3 = subgroupBallot((l & 8u) != 0u).x;
        uint b = ((l & 1u) != 0u ? b0 : ~b0)
               & ((l & 2u) != 0u ? b1 : ~b1)
               & ((l & 4u) != 0u ? b2 : ~b2)
               & ((l & 8u) != 0u ? b3 : ~b3);
        uint rank = bitCount(b & lt_mask);
        uint run = l != 0u ? lds_run[max(l, 1u) - 1u] : 0u;
        uint fl = subgroupShuffle(first, l);
        uint ol = subgroupShuffle(offs, l);
        subgroupBarrier();
        if (l != 0u) {
            if (rank == 0u)
                lds_run[l - 1u] = run + bitCount(b);
            uint idx = run + rank;
            uint cw = fl + idx;
            if (sbase != NONE)
                sorted_or(sbase + ol + idx, s);
            if (l <= root) {
                uint start = mode == 2 ? 0u : bitfieldReverse(cw) >> (32 - l);
                uint step = mode == 2 ? 1u : 1u << l;
                for (uint k = start; k < entries; k += step)
                    half_or(tab + k, s | (l << 9));
            }
        }
        subgroupBarrier();
    }
    return mode;
}

uint decode(uint64_t buf, uint tab, uint root, out uint len) {
    uint e = half_get(tab + (uint(buf) & ((1u << root) - 1u)));
    len = e >> 9;
    return e & 511u;
}

uint long_code(uint c, uint p[8], uint root, out uint len) {
    uint q = p[0];
    uint n = root + 1u;
    bool g;
    if (root < 14u) {
        g = c >= p[0];
        q = g ? p[1] : q;
        n += g ? 1u : 0u;
    }
    if (root < 13u) {
        g = c >= p[1];
        q = g ? p[2] : q;
        n += g ? 1u : 0u;
    }
    if (root < 12u) {
        g = c >= p[2];
        q = g ? p[3] : q;
        n += g ? 1u : 0u;
    }
    if (root < 11u) {
        g = c >= p[3];
        q = g ? p[4] : q;
        n += g ? 1u : 0u;
    }
    if (root < 10u) {
        g = c >= p[4];
        q = g ? p[5] : q;
        n += g ? 1u : 0u;
    }
    if (root < 9u) {
        g = c >= p[5];
        q = g ? p[6] : q;
        n += g ? 1u : 0u;
    }
    if (root < 8u) {
        g = c >= p[6];
        q = g ? p[7] : q;
        n += g ? 1u : 0u;
    }
    len = n;
    return sorted_get(min((q + (c >> (31u - n))) & 0xffffu, 320u));
}

uint order_of(uint i) {
    if (i < 3u)
        return 16u + i;
    if (i == 3u)
        return 0u;
    return (i & 1u) == 0u ? 8u + ((i - 4u) >> 1) : 7u - ((i - 5u) >> 1);
}

uint dynamic_codes(inout reader_t r, inout lane_t l, out bool dist_empty, out uint lit_p[8], out uint dist_p[8]) {
    uint hdr = subgroupShuffle(uint(l.buf), 0);
    uint hlit = (hdr & 31u) + 257u;
    uint hdist = ((hdr >> 5) & 31u) + 1u;
    uint hclen = ((hdr >> 10) & 15u) + 4u;
    dist_empty = false;
    if (lane == 0)
        eat(l, 14);
    refill(r, l, lane == 0);

    for (uint i = lane; i < 43; i += LANES)
        lds_lens[i] = 0u;
    subgroupBarrier();
    bool alive = lane < hclen;
    uint pl = alive ? uint(l.buf) & 7u : 0u;
    if (alive) {
        eat(l, 3);
        if (pl != 0u)
            len_or(LENS_PRE + order_of(lane), pl);
    }
    refill(r, l, alive);
    subgroupBarrier();
    uint mode = build(19, LENS_PRE, TAB_PRE, NONE, PRE_ROOT, lit_p);
    if (mode == 1 || mode == 3)
        return ERR_PRECODE;

    uint total = hlit + hdist;
    uint n = 0;
    uint last = NONE;
    while (n < total) {
        uint len;
        uint sym = decode(l.buf, TAB_PRE, PRE_ROOT, len);
        uint ext = sym < 16u ? 0u : sym == 16u ? 2u : sym == 17u ? 3u : 7u;
        uint base = sym < 16u ? 1u : sym == 18u ? 11u : 3u;
        uint runlen = base + ((uint(l.buf) >> len) & ((1u << ext) - 1u));
        uint val = sym < 16u ? sym : 0u;
        uint m = subgroupBallot(sym != 16u).x;
        int j = findMSB(m & lt_mask);
        uint prevval = subgroupShuffle(val, j >= 0 ? uint(j) : 0u);
        if (j < 0)
            prevval = last;
        if (sym == 16u)
            val = prevval;
        uint start = n + subgroupExclusiveAdd(runlen);
        alive = start < total;
        bool bad = alive && (len == 0u || sym > 18u || (sym == 16u && prevval == NONE) || start + runlen > total);
        if (subgroupAny(bad))
            return ERR_CODE_LENGTHS;
        if (alive) {
            eat(l, len + ext);
            if (val != 0u)
                for (uint k = 0; k < runlen; k++)
                    len_or(start + k, val);
        }
        refill(r, l, alive);
        n = subgroupShuffle(start + runlen, LANES - 1);
        last = subgroupShuffle(val, LANES - 1);
        if (r.err != 0u)
            return r.err;
    }
    subgroupBarrier();
    if ((hlit > 286u && len_get(286) != 0u) || (hlit > 287u && len_get(287) != 0u) || len_get(256) == 0u)
        return ERR_LITLEN_CODE;
    mode = build(hlit, 0, TAB_LIT, SORTED_LIT, LIT_ROOT, lit_p);
    if (mode == 1 || mode == 3)
        return ERR_LITLEN_CODE;
    mode = build(hdist, hlit, TAB_DIST, SORTED_DIST, DIST_ROOT, dist_p);
    if (mode == 3)
        return ERR_DIST_CODE;
    dist_empty = mode == 1;
    uint dl = lane < hdist ? len_get(hlit + lane) : 0u;
    uint near_weight = subgroupAdd(lane < 18u && dl != 0u ? 1u << (15u - dl) : 0u);
    uint ll = lane < 29u && 257u + lane < hlit ? len_get(257u + lane) : 0u;
    uint weight = ll != 0u ? 1u << (15u - ll) : 0u;
    uint match_weight = subgroupAdd(weight);
    uint long_weight = subgroupAdd(lane >= 14u ? weight : 0u);
    g_cache = near_weight >= 6554u && long_weight * 4u < match_weight;
    g_lits = match_weight < 2048u;
    return 0u;
}

void fixed_codes(out uint pl[8], out uint pd[8]) {
    g_cache = true;
    for (uint d = lane; d < 40; d += LANES) {
        uint w = 0;
        for (uint k = 0; k < 8; k++) {
            uint s = d * 8 + k;
            uint v = s < 144u ? 8u : s < 256u ? 9u : s < 280u ? 7u : s < 288u ? 8u : 5u;
            w |= v << (k * 4);
        }
        lds_lens[d] = w;
    }
    subgroupBarrier();
    build(288, 0, TAB_LIT, SORTED_LIT, LIT_ROOT, pl);
    build(32, 288, TAB_DIST, SORTED_DIST, DIST_ROOT, pd);
}

uint stored_block(inout reader_t r, inout lane_t l, uint dst, uint size, inout uint pos) {
    uint n = subgroupShuffle(uint(l.buf), 0) & 0xffffu;
    if (lane == 0)
        eat(l, 16);
    refill(r, l, lane == 0);
    if (n > size - pos)
        return ERR_OUTPUT;
    g_win = pos + n >= RING ? pos + n - RING : 0u;
    uint phase = (l.cnt - 32u) >> 3;
    uint b0 = subgroupBallot((phase & 1u) != 0u).x;
    uint b1 = subgroupBallot((phase & 2u) != 0u).x;
    uint same = ((phase & 1u) != 0u ? b0 : ~b0) & ((phase & 2u) != 0u ? b1 : ~b1);
    uint before = phase == 0u ? 0u : phase == 1u ? ~(b0 | b1) : phase == 2u ? ~b1 : ~(b0 & b1);
    uint rank = bitCount(before) + bitCount(same & lt_mask);
    uint i = 0u;
    for (; i + 4u * LANES <= n; i += 4u * LANES) {
        uint v = uint(l.buf);
        uint p = pos + i + lane;
        out_set(dst + p, v & 255u);
        out_set(dst + p + LANES, (v >> 8) & 255u);
        out_set(dst + p + 2u * LANES, (v >> 16) & 255u);
        out_set(dst + p + 3u * LANES, v >> 24);
        uint w = in_word(r.src + min(r.next + rank, r.words - 1u));
        l.buf = (l.buf >> 32) | (uint64_t(w) << (l.cnt - 32u));
        r.next += LANES;
        if (r.next > r.words) {
            r.err = ERR_INPUT;
            return r.err;
        }
    }
    r.wbase = r.next;
    stage_sync(r);
    for (; i < n; i += LANES) {
        bool alive = i + lane < n;
        if (alive) {
            out_set(dst + pos + i + lane, uint(l.buf) & 0xffu);
            eat(l, 8);
        }
        refill(r, l, alive);
        if (r.err != 0u)
            return r.err;
    }
    pos += n;
    return 0u;
}

void store_fence() {
    if (EXPERIMENT == 11)
        memoryBarrierBuffer();
    else
        subgroupBarrier();
}

void copy_own(uint dst, uint cp, uint cl, uint cd, uint longest) {
    uint src = cl != 0u ? dst + cp - cd : dst;
    uint last = (src + max(cl, 1u) - 1u) >> 2;
    uint shift = (src & 3u) * 8u;
    uint words[7] = uint[7](0u, 0u, 0u, 0u, 0u, 0u, 0u);
    [[unroll]] for (uint i = 0; i < 7; i++) {
        if (i * 4u < longest + 4u)
            words[i] = out_word(min((src >> 2) + i, last));
    }
    [[unroll]] for (uint k = 0; k < 6; k++) {
        if (k * 4u >= longest)
            continue;
        uint v = words[k];
        if (shift != 0u)
            v = (v >> shift) | (words[k + 1u] << (32u - shift));
        uint i = k * 4u;
        if (i < cl) {
            out_set(dst + cp + i, v & 255u);
            ring_set(cp + i, v & 255u);
        }
        if (i + 1u < cl) {
            out_set(dst + cp + i + 1u, (v >> 8) & 255u);
            ring_set(cp + i + 1u, (v >> 8) & 255u);
        }
        if (i + 2u < cl) {
            out_set(dst + cp + i + 2u, (v >> 16) & 255u);
            ring_set(cp + i + 2u, (v >> 16) & 255u);
        }
        if (i + 3u < cl) {
            out_set(dst + cp + i + 3u, v >> 24);
            ring_set(cp + i + 3u, v >> 24);
        }
    }
}

void ring_any(uint x, uint lim, uint v) {
    uint ri = x >= g_win && x < lim ? x & (RING - 1u) : RING;
    lds_ring[ri] = uint8_t(v);
}

void copy_own_ovr(uint dst, uint cp, uint cl, uint cd, uint longest, uint lim) {
    if (cl == 0u)
        return;
    uint src = dst + cp - cd;
    uint last = (src + cl - 1u) >> 2;
    uint shift = (src & 3u) * 8u;
    uint words[7] = uint[7](0u, 0u, 0u, 0u, 0u, 0u, 0u);
    [[unroll]] for (uint i = 0; i < 7; i++) {
        if (i * 4u < longest + 4u)
            words[i] = out_word(min((src >> 2) + i, last));
    }
    [[unroll]] for (int k = 5; k >= 0; k--) {
        if (uint(k) * 4u >= longest)
            continue;
        uint v = words[k];
        if (shift != 0u)
            v = (v >> shift) | (words[k + 1] << (32u - shift));
        uint i = cp + uint(k) * 4u;
        out_set(dst + i + 3u, v >> 24);
        out_set(dst + i + 2u, (v >> 16) & 255u);
        out_set(dst + i + 1u, (v >> 8) & 255u);
        out_set(dst + i, v & 255u);
        if (g_mirror && RING != 0u) {
            ring_any(i + 3u, lim, v >> 24);
            ring_any(i + 2u, lim, (v >> 16) & 255u);
            ring_any(i + 1u, lim, (v >> 8) & 255u);
            ring_any(i, lim, v & 255u);
        }
    }
}

struct pat_t {
    bool valid;
    uint cp;
    uint cl;
    uint cd;
    uint p0, p1, p2, p3;
};

uint pat_index(uint i, uint cd) {
    return cd == 3u ? i % 3u : (i & (cd - 1u));
}

uint pat_byte(pat_t q, uint o) {
    uint m = pat_index(o, q.cd);
    return m == 0u ? q.p0 : m == 1u ? q.p1 : m == 2u ? q.p2 : q.p3;
}

void copy_pattern(uint dst, uint cp, uint cl, uint cd, inout pat_t q) {
    uint k1 = cd > 1u ? 1u : 0u;
    uint k2 = cd > 2u ? 2u : 0u;
    uint k3 = cd == 4u ? 3u : cd == 2u ? 1u : 0u;
    uint p0, p1, p2, p3;
    if (q.valid && cp - cd >= q.cp && cp <= q.cp + q.cl) {
        uint o = cp - cd - q.cp;
        p0 = pat_byte(q, o);
        p1 = pat_byte(q, o + k1);
        p2 = pat_byte(q, o + k2);
        p3 = pat_byte(q, o + k3);
    } else {
        p0 = out_get(dst + cp - cd);
        p1 = out_get(dst + cp - cd + k1);
        p2 = out_get(dst + cp - cd + k2);
        p3 = out_get(dst + cp - cd + k3);
    }
    uint head = min((4u - (cp & 3u)) & 3u, cl);
    uint body = (cl - head) & ~3u;
    uint tail = cl - head - body;
    if (lane < head) {
        uint m = pat_index(lane, cd);
        out_set(dst + cp + lane, m == 0u ? p0 : m == 1u ? p1 : m == 2u ? p2 : p3);
    }
    uint ph0 = cd == 3u ? head % 3u : 0u;
    uint d0 = (p0 | (p1 << 8) | (p2 << 16) | (p3 << 24));
    uint d1 = (p1 | (p2 << 8) | (p0 << 16) | (p1 << 24));
    uint d2 = (p2 | (p0 << 8) | (p1 << 16) | (p2 << 24));
    if (cd == 3u) {
        d0 = p0 | (p1 << 8) | (p2 << 16) | (p0 << 24);
    } else {
        uint m = head & (cd - 1u);
        uint e0 = m == 0u ? p0 : m == 1u ? p1 : m == 2u ? p2 : p3;
        uint e1 = (m + 1u) % 4u == 0u ? p0 : (m + 1u) % 4u == 1u ? p1 : (m + 1u) % 4u == 2u ? p2 : p3;
        uint e2 = (m + 2u) % 4u == 0u ? p0 : (m + 2u) % 4u == 1u ? p1 : (m + 2u) % 4u == 2u ? p2 : p3;
        uint e3 = (m + 3u) % 4u == 0u ? p0 : (m + 3u) % 4u == 1u ? p1 : (m + 3u) % 4u == 2u ? p2 : p3;
        d0 = e0 | (e1 << 8) | (e2 << 16) | (e3 << 24);
    }
    uint ph = cd == 3u ? (ph0 + lane) % 3u : 0u;
    for (uint i0 = 0; i0 < body; i0 += 4 * LANES) {
        uint i = i0 + 4u * lane;
        uint v = ph == 0u ? d0 : ph == 1u ? d1 : d2;
        if (i < body)
            out_set32(dst + cp + head + i, v);
        if (cd == 3u)
            ph = ph >= 1u ? ph - 1u : 2u;
    }
    if (lane < tail) {
        uint o = head + body + lane;
        uint m = pat_index(o, cd);
        out_set(dst + cp + o, m == 0u ? p0 : m == 1u ? p1 : m == 2u ? p2 : p3);
    }
    q.valid = true;
    q.cp = cp;
    q.cl = cl;
    q.cd = cd;
    q.p0 = p0;
    q.p1 = p1;
    q.p2 = p2;
    q.p3 = p3;
}

void copy_dwords(uint dst, uint cp, uint cl, uint cd) {
    uint head = min((4u - ((dst + cp) & 3u)) & 3u, cl);
    uint body = (cl - head) & ~3u;
    uint tail = cl - head - body;
    uint m = (4u - (cd & 3u)) & 3u;
    uint safe = dst + cp - cd;
    uint wl = ((body - 1u) & (4u * LANES - 1u)) + 1u;
    bool fold = tail != 0u && wl < 4u * LANES && cd > wl + 7u;
    uint hv = out_get(lane < head ? dst + cp + lane - cd : safe);
    bool head_first = cd < 4u * LANES + head;
    if (head_first && lane < head)
        out_set(dst + cp + lane, hv);
    for (uint i0 = 0; i0 < body; i0 += 4u * LANES) {
        uint i = i0 + 4u * lane;
        bool on = i < body;
        bool tl = fold && i == body;
        uint d = dst + cp + head + i;
        uint s = (on || tl) ? d - cd : safe;
        uint v = out_word(s >> 2);
        if (m != 0u)
            v = (v >> (8u * m)) | (out_word((s >> 2) + 1u) << (32u - 8u * m));
        if (!head_first && i0 == 0u && lane < head)
            out_set(dst + cp + lane, hv);
        if (on)
            out_set32(d, v);
        if (tl) {
            out_set(d, v & 0xffu);
            if (tail > 1u)
                out_set(d + 1u, (v >> 8) & 0xffu);
            if (tail > 2u)
                out_set(d + 2u, (v >> 16) & 0xffu);
        }
    }
    if (!fold && lane < tail)
        out_set(dst + cp + head + body + lane, out_get(dst + cp + head + body + lane - cd));
}

void copy_one(uint dst, uint cp, uint cl, uint cd, inout pat_t q) {
    if (cd <= 4u) {
        copy_pattern(dst, cp, cl, cd, q);
        return;
    }
    q.valid = false;
    if (cd >= 4u * LANES && cl >= 8u * LANES && EXPERIMENT != 23) {
        copy_dwords(dst, cp, cl, cd);
        return;
    }
    for (uint i0 = 0; i0 < cl; i0 += 4 * LANES) {
        uint i1 = min(i0 + lane, cl - 1u), i2 = min(i0 + lane + LANES, cl - 1u);
        uint i3 = min(i0 + lane + 2u * LANES, cl - 1u), i4 = min(i0 + lane + 3u * LANES, cl - 1u);
        uint j1 = i1, j2 = i2, j3 = i3, j4 = i4;
        if (cl > cd && i0 + 4 * LANES > cd) {
            j1 = i1 >= cd ? i1 % cd : i1;
            j2 = i2 >= cd ? i2 % cd : i2;
            j3 = i3 >= cd ? i3 % cd : i3;
            j4 = i4 >= cd ? i4 % cd : i4;
        }
        uint v1 = out_get(dst + cp - cd + j1);
        uint v2 = out_get(dst + cp - cd + j2);
        uint v3 = out_get(dst + cp - cd + j3);
        uint v4 = out_get(dst + cp - cd + j4);
        out_set(dst + cp + i1, v1);
        out_set(dst + cp + i2, v2);
        out_set(dst + cp + i3, v3);
        out_set(dst + cp + i4, v4);
    }
}

void copy_pair(uint dst, uint ca, uint la, uint da, uint cb, uint lb, uint db) {
    uint a1 = min(lane, la - 1u), a2 = min(lane + LANES, la - 1u);
    uint a3 = min(lane + 2u * LANES, la - 1u), a4 = min(lane + 3u * LANES, la - 1u);
    uint b1 = min(lane, lb - 1u), b2 = min(lane + LANES, lb - 1u);
    uint b3 = min(lane + 2u * LANES, lb - 1u), b4 = min(lane + 3u * LANES, lb - 1u);
    uint va1 = out_get(dst + ca - da + a1), va2 = out_get(dst + ca - da + a2);
    uint va3 = out_get(dst + ca - da + a3), va4 = out_get(dst + ca - da + a4);
    uint vb1 = out_get(dst + cb - db + b1), vb2 = out_get(dst + cb - db + b2);
    uint vb3 = out_get(dst + cb - db + b3), vb4 = out_get(dst + cb - db + b4);
    out_set(dst + ca + a1, va1);
    out_set(dst + ca + a2, va2);
    out_set(dst + ca + a3, va3);
    out_set(dst + ca + a4, va4);
    out_set(dst + cb + b1, vb1);
    out_set(dst + cb + b2, vb2);
    out_set(dst + cb + b3, vb3);
    out_set(dst + cb + b4, vb4);
}

uint short_offset(uint i, uint dist) {
    [[unroll]] for (int shift = 4; shift >= 0; shift--) {
        uint step = dist << shift;
        i -= i >= step ? step : 0u;
    }
    return i;
}

void copy_short(uint dst, uint cp, uint cl, uint cd) {
    uint c = min(lane, cl - 1u);
    uint j = cl > cd ? short_offset(c, cd) : c;
    uint v = out_get(dst + cp - cd + j);
    out_set(dst + cp + c, v);
    ring_set(cp + c, v);
}

void copy_ring(uint dst, uint cp, uint cl, uint cd) {
    uint c = min(lane, cl - 1u);
    uint j = cl > cd ? short_offset(c, cd) : c;
    uint v = ring_get(cp - cd + j);
    out_set(dst + cp + c, v);
    ring_set(cp + c, v);
}

uint huffman_block(inout reader_t r, inout lane_t l, uint dst, uint size, inout uint pos, inout uint ring_from,
                   bool dist_empty, uint pl[8], uint pd[8], bool fast) {
    uint pend = 0, mpos = 0, mlen = 0;
    uint seg = pos;
    bool final_round = false;
    uint plp = 0u, pls = 0u;
    bool plv = false;
    for (;;) {
        bool fetch = r.wbase - r.next < 64u;
        uint fw = 0u;
        if (fetch)
            fw = load_packet(r, r.wbase + lane);
        if (fast && !final_round && !subgroupAny(pend != 0u)) {
            uint e = half_get(TAB_LIT + (uint(l.buf) & ((1u << LIT_ROOT) - 1u)));
            uint flen = e >> 9;
            uint fsym = e & 511u;
            if (subgroupAll(flen != 0u && fsym < 256u) && pos + LANES <= size) {
                eat(l, flen);
                refill_staged(r, l, true);
                uint p = pos + lane;
                g_win = pos + LANES >= RING ? pos + LANES - RING : 0u;
                out_set(dst + p, fsym);
                ring_set(p, fsym);
                seg = pos;
                pos += LANES;
                if (fetch) {
                    lds_in[(r.wbase + lane) & (QW - 1u)] = fw;
                    r.wbase += LANES;
                    shared_fence();
                }
                continue;
            }
        }
        bool is_dist = pend != 0u;
        uint tab = is_dist ? TAB_DIST : TAB_LIT;
        uint root = is_dist ? DIST_ROOT : LIT_ROOT;
        uint len;
        uint sym = decode(l.buf, tab, root, len);
        if (len == 0u) {
            uint c = (bitfieldReverse(uint(l.buf)) >> 1) | 0xffffu;
            if (is_dist)
                sym = long_code(c, pd, DIST_ROOT, len);
            else
                sym = long_code(c, pl, LIT_ROOT, len);
        }

        uint k = is_dist ? 1u : 2u;
        uint n0 = 2u << k;
        uint b0 = is_dist ? 1u : 3u;
        uint slot = is_dist ? sym : sym - 257u;
        uint ext = slot < n0 ? 0u : ((slot - n0) >> k) + 1u;
        uint base = slot < n0 ? b0 + slot : b0 + (1u << (ext + k)) + ((slot & ((1u << k) - 1u)) << ext);
        bool is_lit = !is_dist && sym < 256u;
        bool is_eob = !is_dist && sym == 256u;
        if (is_lit || is_eob) {
            ext = 0u;
            base = is_lit ? 1u : 0u;
        } else if (!is_dist && slot == 28u) {
            ext = 16u;
            base = 3u;
        }
        uint val = base + ((uint(l.buf) >> len) & ((1u << ext) - 1u));
        bool bad = len == 0u || (is_dist ? (sym >= 32u || dist_empty) : sym > 285u);

        uint eobmask = subgroupBallot(is_eob).x;
        bool alive = is_dist || (!final_round && (eobmask == 0u || lane <= uint(findLSB(eobmask))));
        bool fault = subgroupAny((bad && alive) || (is_dist && val > mpos));
        if (alive)
            eat(l, len + ext);
        refill_staged(r, l, alive);

        uint sz = (alive && !is_dist && !is_eob) ? val : 0u;
        uint off = subgroupExclusiveAdd(sz);
        uint total = subgroupBroadcast(off + sz, LANES - 1);
        if (fault || total > size - pos || r.err != 0u) {
            uint err = subgroupAny(bad && alive) ? ERR_SYMBOL : 0u;
            if (total > size - pos)
                err = ERR_OUTPUT;
            if (subgroupAny(is_dist && val > mpos))
                err = ERR_DISTANCE;
            return err != 0u ? err : r.err;
        }
        uint p = pos + off;
        g_win = pos + total >= RING ? pos + total - RING : 0u;
        if (alive && is_lit) {
            out_set(dst + p, sym);
            ring_set(p, sym);
        }

        if (subgroupAny(is_dist)) {
            store_fence();
            uint ring_lo = max(g_win, ring_from);
            bool dep = is_dist && mpos - val + mlen > seg;
            bool shortm = is_dist && !dep && mlen <= 24u;
            uint longest = subgroupMax(shortm ? mlen : 0u);
            if (longest != 0u && pos + 24u <= size) {
                copy_own_ovr(dst, mpos, shortm ? mlen : 0u, val, longest, pos + total);
                longest = 0u;
                subgroupBarrier();
                if (plv) {
                    out_set(dst + plp, pls);
                    ring_set(plp, pls);
                }
                if (alive && is_lit) {
                    out_set(dst + p, sym);
                    ring_set(p, sym);
                }
            }
            if (longest != 0u)
                copy_own(dst, mpos, shortm ? mlen : 0u, val, longest);
            pat_t q = pat_t(false, 0u, 0u, 0u, 0u, 0u, 0u, 0u);
            uint lmask = subgroupBallot(is_dist && !dep && mlen > 24u).x;
            uint pmask = subgroupBallot(is_dist && !dep && mlen > 24u && mlen <= 4u * LANES && val >= mlen).x;
            while (bitCount(pmask) >= 2u) {
                uint ia = uint(findLSB(pmask));
                pmask &= pmask - 1u;
                uint ib = uint(findLSB(pmask));
                pmask &= pmask - 1u;
                lmask &= ~((1u << ia) | (1u << ib));
                uint ca = subgroupShuffle(mpos, ia), cb = subgroupShuffle(mpos, ib);
                uint la = subgroupShuffle(mlen, ia), lb = subgroupShuffle(mlen, ib);
                copy_pair(dst, ca, la, subgroupShuffle(val, ia), cb, lb, subgroupShuffle(val, ib));
                ring_from = max(ring_from, max(ca + la, cb + lb));
            }
            while (lmask != 0u) {
                uint i = uint(findLSB(lmask));
                uint cp = subgroupShuffle(mpos, i);
                uint cl = subgroupShuffle(mlen, i);
                copy_one(dst, cp, cl, subgroupShuffle(val, i), q);
                ring_from = max(ring_from, cp + cl);
                lmask &= lmask - 1u;
            }
            uint dmask = subgroupBallot(dep).x;
            while (dmask != 0u) {
                uint i = uint(findLSB(dmask));
                uint cp = subgroupShuffle(mpos, i);
                uint cl = subgroupShuffle(mlen, i);
                uint cd = subgroupShuffle(val, i);
                ring_lo = max(ring_lo, ring_from);
                if (cl <= LANES && cp - cd >= ring_lo && g_mirror && RING != 0u && EXPERIMENT != 22) {
                    subgroupBarrier();
                    copy_ring(dst, cp, cl, cd);
                } else {
                    store_fence();
                    if (cl <= LANES) {
                        copy_short(dst, cp, cl, cd);
                    } else {
                        copy_one(dst, cp, cl, cd, q);
                        ring_from = max(ring_from, cp + cl);
                    }
                }
                dmask &= dmask - 1u;
            }
        }

        plp = p;
        pls = sym;
        plv = alive && is_lit;
        if (is_dist)
            pend = 0u;
        else if (alive && sym > 256u) {
            pend = 1u;
            mpos = p;
            mlen = val;
        }
        seg = pos;
        pos += total;
        if (fetch) {
            lds_in[(r.wbase + lane) & (QW - 1u)] = fw;
            r.wbase += LANES;
            shared_fence();
        }
        if (final_round)
            break;
        if (eobmask != 0u)
            final_round = true;
    }
    return 0u;
}

void main() {
    lane = gl_SubgroupInvocationID;
    if (lane >= LANES)
        return;
    lt_mask = (1u << lane) - 1u;
    uint tile = gl_WorkGroupID.x;
    if (uint64_t(pc.count) != 0ul && tile >= pc.count.n)
        return;
    tile_t t;
    if (pc.stride == 0u) {
        t = pc.tiles.tiles[tile];
        g_src = src_ref(uint64_t(pc.src) + uint64_t(t.src) * 4ul);
        g_dst = dst_ref(uint64_t(pc.dst) + uint64_t(t.dst));
        t.src = 0u;
        t.dst = 0u;
    } else {
        region_t g = region_ref(uint64_t(pc.tiles) + uint64_t(tile) * pc.stride).region;
        g_src = src_ref(g.src);
        g_dst = dst_ref(g.dst);
        t.src = 0u;
        t.words = uint((min(g.csize, 0x40000ul) + 3ul) >> 2);
        t.dst = 0u;
        t.size = uint(min(g.size, 0x10000ul));
    }
    if (t.words < LANES) {
        if (lane == 0 && uint64_t(pc.status) != 0ul)
            pc.status.words[tile] = ERR_INPUT;
        return;
    }
    g_win = 0u;
    reader_t r;
    r.src = t.src;
    r.words = t.words;
    r.next = LANES;
    r.wbase = LANES;
    r.err = 0u;
    lane_t l;
    l.buf = uint64_t(in_word(r.src + lane));
    l.cnt = 32u;
    stage_sync(r);
    uint pos = 0u;
    uint ring_from = 0u;
    uint err = 0u;
    uint pl[8];
    uint pd[8];

    for (;;) {
        uint hdr = subgroupShuffle(uint(l.buf), 0);
        uint final = hdr & 1u;
        uint type = (hdr >> 1) & 3u;
        if (lane == 0)
            eat(l, 3);
        refill(r, l, lane == 0);
        if (r.err != 0u) {
            err = r.err;
            break;
        }
        if (type == 0u) {
            err = stored_block(r, l, t.dst, t.size, pos);
            ring_from = pos;
        } else if (type == 3u) {
            err = ERR_BLOCK_TYPE;
        } else {
            bool dist_empty = false;
            if (type == 2u)
                err = dynamic_codes(r, l, dist_empty, pl, pd);
            else
                fixed_codes(pl, pd);
            if (err == 0u) {
                if (g_cache && RING != 0u) {
                    g_mirror = true;
                    err = huffman_block(r, l, t.dst, t.size, pos, ring_from, dist_empty, pl, pd, false);
                } else if (g_lits && type == 2u) {
                    g_mirror = false;
                    err = huffman_block(r, l, t.dst, t.size, pos, ring_from, dist_empty, pl, pd, true);
                    ring_from = pos;
                } else {
                    g_mirror = false;
                    err = huffman_block(r, l, t.dst, t.size, pos, ring_from, dist_empty, pl, pd, false);
                    ring_from = pos;
                }
            }
        }
        if (err != 0u || final != 0u)
            break;
    }
    if (err == 0u && pos != t.size)
        err = ERR_SIZE;
    if (lane == 0 && uint64_t(pc.status) != 0ul)
        pc.status.words[tile] = err;
}
