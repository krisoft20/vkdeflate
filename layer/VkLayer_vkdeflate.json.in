{
    "file_format_version": "1.2.0",
    "layer": {
        "name": "VK_LAYER_vkdeflate_memory_decompression",
        "type": "GLOBAL",
        "library_path": "@LAYER_LIBRARY@",
        "api_version": "1.3.0",
        "implementation_version": "1",
        "description": "GDeflate memory decompression through vkdeflate's compute kernel",
        "device_extensions": [
            {
                "name": "VK_EXT_memory_decompression",
                "spec_version": "1",
                "entrypoints": [ "vkCmdDecompressMemoryEXT", "vkCmdDecompressMemoryIndirectCountEXT" ]
            },
            {
                "name": "VK_NV_memory_decompression",
                "spec_version": "1",
                "entrypoints": [ "vkCmdDecompressMemoryNV", "vkCmdDecompressMemoryIndirectCountNV" ]
            }
        ]
    }
}
